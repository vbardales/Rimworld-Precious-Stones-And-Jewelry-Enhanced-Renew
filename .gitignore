# Steam does not read .gitignore: SteamUGC.SetItemContent sends the published folder (Mod/) as it
# stands on disk. Everything else here (Art/, Source/, the docs) stays out of it by construction.

# Build intermediates (Source/Directory.Build.props redirects them to build/).
build/
Source/obj/
Source/bin/

# Preview render checks, local only.
Art/.render/

# Showcase prompt notes, deleted once Preview.png and ModIcon.png are done.
PROMPT_*.md

# Development environments and system files.
.vs/
.vscode/
.idea/
*.user
*.suo
*.dds
Thumbs.db
desktop.ini
.DS_Store
.claude/

# Pickle run reports, disk only.
Tests/Pickle/Evidence/
Tests/Pickle/Inbox/
Tests/Pickle/Parked/
